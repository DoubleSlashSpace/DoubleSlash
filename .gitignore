# External project junction — tracked by its own repo
ConquerD_www/

# Release signing keys (public key + hex are committed; private must never be committed)
keys/*-private.pem
keys/*-private.key
*-private.pem
*-private.key

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Identity keys (never commit!)
.doubleslash/
.conquerd/

# Logs
*.log

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
# cargo-llvm-cov outputs from scripts/coverage.ps1 / coverage.sh
/coverage/
*.lcov
test_results.txt
test_run_output.txt
test_check.txt

# Build / CI logs (PowerShell capture artifacts)
build_check.txt
build_output.txt
rust/build_check.txt
rust/build_check_phase3.txt
rust/check_out.txt

# Local debug / run capture artifacts (from client and tools)
debug_*.txt
rust/doubleslash-client/debug_*.txt
rust/conquerd-client/debug_*.txt

# Loose compiled extensions (dev-only copies)
doubleslash_*.dll
conquerd_crypto.dll
conquerd_quic.dll
conquerd_audio.dll

# Auto-generated packaging metadata
packaging/version_info.txt

# Linting / type-checking caches and reports
.mypy_cache/
.ruff_cache/
ruff_audit.json
/.clientA/Downloads
/.clientB/AppData
/.clientB/Downloads
/.clientC/AppData
/.tmp-run
/.clientA/AppData
/.clientA
/.clientB
/.clientC
/rust/target
/rust/doubleslash-client/target-check
/rust/conquerd-client/target-check
/rust/target-check
/rust/doubleslash-client/target
/rust/conquerd-client/target
/terminals
/agent-tools
# Grok / agent MCP tool schema cache (not project source)
/mcps
/.claude/skills
# Headless client cargo targets (build_headless.bat)
/rust/target-headless
/rust/target-headless2
/rust/target-headless-check
rust/sz2.html

# Android client
# Gradle sets CARGO_TARGET_DIR here so Android objects stay out of rust/target.
/rust/target-android
# Default cargo target for the JNI workspace (`cd rust/doubleslash-android && cargo ndk …`).
/rust/doubleslash-android/target
/rust/conquerd-android/target

# Supernode-manager workspace (nested .gitignore also covers these)
/rust/doubleslash-supernode-manager/target
/rust/doubleslash-supernode-manager/bin
/rust/doubleslash-supernode-manager/terminals
/rust/doubleslash-supernode-manager/agent-tools

# Leftover pre-rename crate copies (git-mv remnants; do not commit)
/rust/conquerd-client/
/rust/conquerd-android/
/rust/conquerd-opus/
/rust/conquerd-features/
/rust/conquerd-supernode/
/rust/conquerd-installer/
/rust/conquerd-vpx/
/rust/conquerd-supernode-manager/
/android/.gradle
/android/.kotlin
/android/.cxx
/android/app/.cxx
/android/build
/android/app/build
/android/captures
/android/local.properties
# Cross-compiled client core, dropped here by cargo-ndk (tens of MB per ABI)
/android/app/src/main/jniLibs
*.apk
*.aab
*.jks
*.keystore
*.hprof
