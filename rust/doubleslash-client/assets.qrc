<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/assets">
        <!-- Application icon — embedded so QGuiApplication::setWindowIcon()
             can load it at runtime (taskbar, alt-tab, window title bar).
             Path is relative to this QRC file (rust/doubleslash-client/). -->
        <file alias="doubleslash.ico">../../assets/doubleslash.ico</file>
        <file alias="doubleslash.ico">../../assets/doubleslash.ico</file>
    </qresource>
</RCC>
