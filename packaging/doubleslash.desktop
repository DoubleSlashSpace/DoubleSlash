[Desktop Entry]
Type=Application
Name=DoubleSlash
GenericName=P2P Voice & Chat
Comment=Privacy-first invite-only peer-to-peer voice and chat
Exec=doubleslash %u
Icon=doubleslash
Terminal=false
Categories=Network;Chat;InstantMessaging;AudioVideo;
Keywords=voice;chat;p2p;privacy;encrypted;doubleslash;
StartupWMClass=DoubleSlash
StartupNotify=true

# Invite hand-off is doubleslash:// (and d://). conquerd:// is a portal alias.
MimeType=x-scheme-handler/doubleslash;x-scheme-handler/d;x-scheme-handler/conquerd;
